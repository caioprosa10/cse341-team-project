{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "JSON endpoints that power the Kizuna Rail pages: trips, schedules, bookings, ticket classes, stations and trains."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {
    "schemas": {
      "PageMeta": {
        "type": "object",
        "description": "Where this response sits in the full set of results.",
        "properties": {
          "page": {
            "type": "integer",
            "description": "The page that was returned, starting at 1",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "description": "The most items a page can hold",
            "example": 10
          },
          "totalItems": {
            "type": "integer",
            "description": "How many items match, across every page",
            "example": 6
          },
          "totalPages": {
            "type": "integer",
            "description": "How many pages there are at this limit (0 when nothing matches)",
            "example": 1
          },
          "hasPreviousPage": {
            "type": "boolean",
            "example": false
          },
          "hasNextPage": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "TripFilters": {
        "type": "object",
        "description": "The filters that were applied, after trimming and lowercasing. A filter that was not used is null.\n",
        "properties": {
          "region": {
            "type": "string",
            "nullable": true,
            "example": "central"
          },
          "season": {
            "type": "string",
            "nullable": true,
            "example": "autumn"
          },
          "q": {
            "type": "string",
            "nullable": true,
            "example": "gorge"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "page must be a whole number of 1 or more"
          }
        }
      }
    }
  },
  "paths": {
    "/api/trips": {
      "get": {
        "summary": "Search, filter and page through the trips",
        "description": "Returns the trips sorted by name, one page at a time. The trips are in trips and the details of the query are in meta: the paging values and the filters that were applied. region, season and q can be combined, and a trip must match all of them. Without any parameter the first ten trips are returned. A page past the last one is not an error: it returns an empty trips array, and meta.totalPages tells the client where the results end.\n",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": false,
            "description": "The page to return, starting at 1",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "description": "How many trips a page holds, from 1 to 50",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "region",
            "required": false,
            "description": "Only trips in this region. Must be one of the regions returned by /api/trips/filters. Not case sensitive.\n",
            "schema": {
              "type": "string",
              "example": "central"
            }
          },
          {
            "in": "query",
            "name": "season",
            "required": false,
            "description": "Only trips whose best season is this one. Must be one of the seasons returned by /api/trips/filters. Not case sensitive.\n",
            "schema": {
              "type": "string",
              "example": "autumn"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "description": "A keyword to look for anywhere in the trip name or description. Not case sensitive, at most 100 characters. Characters such as ( or * are searched for literally.\n",
            "schema": {
              "type": "string",
              "maxLength": 100,
              "example": "gorge"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the matching trips and the metadata for the query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trips": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "meta": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/PageMeta"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "filters": {
                              "$ref": "#/components/schemas/TripFilters"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "example": {
                  "trips": [
                    {
                      "id": "alpine-panorama",
                      "name": "Alpine Panorama Express",
                      "region": "central",
                      "bestSeason": "autumn"
                    },
                    {
                      "id": "gorge-explorer",
                      "name": "Kurobe Gorge Explorer",
                      "region": "central",
                      "bestSeason": "autumn"
                    }
                  ],
                  "meta": {
                    "page": 1,
                    "limit": 10,
                    "totalItems": 2,
                    "totalPages": 1,
                    "hasPreviousPage": false,
                    "hasNextPage": false,
                    "filters": {
                      "region": "central",
                      "season": "autumn",
                      "q": null
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "page or limit is not a valid whole number, limit is above 50, the region or season does not exist, q is longer than 100 characters, or a parameter was repeated\n",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "region must be one of: central, hokkaido, kansai, northern"
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch trips"
          }
        }
      }
    },
    "/api/trips/filters": {
      "get": {
        "summary": "Get the regions and seasons trips can be filtered by",
        "description": "The distinct regions and best seasons in the trips collection, sorted. The trip list fills its dropdowns from this, and these are the only values /api/trips accepts for region and season.\n",
        "tags": [
          "Trips"
        ],
        "responses": {
          "200": {
            "description": "The available filter values",
            "content": {
              "application/json": {
                "example": {
                  "regions": [
                    "central",
                    "hokkaido",
                    "kansai",
                    "northern"
                  ],
                  "seasons": [
                    "autumn",
                    "spring",
                    "summer",
                    "winter"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Failed to fetch trip filters"
          }
        }
      }
    },
    "/api/trips/{id}": {
      "get": {
        "summary": "Get one trip by id",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom trip id, such as alpine-panorama",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching trip"
          },
          "404": {
            "description": "Trip not found"
          },
          "500": {
            "description": "Failed to fetch trip"
          }
        }
      },
      "put": {
        "summary": "Update a trip",
        "description": "Admin role only. Reading the trips stays public.",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom trip id, such as alpine-panorama",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "startStation": {
                    "type": "string"
                  },
                  "endStation": {
                    "type": "string"
                  },
                  "duration": {
                    "type": "string"
                  },
                  "distance": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated trip"
          },
          "400": {
            "description": "Nothing to update"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a trip",
        "description": "Admin role only.",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Admin role required"
          },
          "404": {
            "description": "Trip not found"
          }
        }
      }
    },
    "/api/trips/{id}/schedules": {
      "get": {
        "summary": "Get the schedules for a trip",
        "description": "Returns every schedule for the trip. When the optional month is given, the schedules are returned only if the trip operates in that month, because schedules store weekdays while the operating months live on the trip itself. A trip that does not run that month returns an empty list.\n",
        "tags": [
          "Schedules"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom trip id, such as alpine-panorama",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": false,
            "description": "Month number from 1 (January) to 12 (December)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The schedules for the trip"
          },
          "400": {
            "description": "The month is not a whole number from 1 to 12"
          },
          "500": {
            "description": "Failed to fetch schedules"
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Get all bookings",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "A list of bookings, newest first"
          },
          "500": {
            "description": "Failed to fetch bookings"
          }
        }
      }
    },
    "/api/ticket-classes": {
      "get": {
        "summary": "Get the ticket classes",
        "description": "Returns every ticket class. When the optional day is given, only the classes sold on that weekday are returned.\n",
        "tags": [
          "Ticket Classes"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "day",
            "required": false,
            "description": "A lowercase weekday name, such as monday",
            "schema": {
              "type": "string",
              "enum": [
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday",
                "sunday"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching ticket classes"
          },
          "400": {
            "description": "The day is not a valid weekday name"
          },
          "500": {
            "description": "Failed to fetch ticket classes"
          }
        }
      }
    },
    "/api/stations": {
      "get": {
        "summary": "Get all stations",
        "tags": [
          "Stations"
        ],
        "responses": {
          "200": {
            "description": "A list of stations"
          },
          "500": {
            "description": "Failed to fetch stations"
          }
        }
      }
    },
    "/api/stations/{id}": {
      "get": {
        "summary": "Get one station by id",
        "tags": [
          "Stations"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom station id, such as nagoya",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching station"
          },
          "404": {
            "description": "Station not found"
          },
          "500": {
            "description": "Failed to fetch station"
          }
        }
      }
    },
    "/api/trains": {
      "get": {
        "summary": "Get all trains",
        "tags": [
          "Trains"
        ],
        "description": "Answers with the trains wrapped in an object, as { \"trains\": [ ... ] }. This endpoint predates the newer ones, which return bare arrays, and the trains page reads payload.trains.\n",
        "responses": {
          "200": {
            "description": "An object with a trains array"
          },
          "500": {
            "description": "Failed to fetch trains"
          }
        }
      }
    },
    "/api/trains/{id}": {
      "get": {
        "summary": "Get one train by id",
        "tags": [
          "Trains"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom train id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching train"
          },
          "404": {
            "description": "Train not found"
          },
          "500": {
            "description": "Failed to fetch train"
          }
        }
      }
    },
    "/api/bookings/{id}": {
      "put": {
        "summary": "Update a booking",
        "description": "Any signed in user may update a booking where their email is one of the passengers. An admin may update any booking.\n",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The booking reference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ticketClass": {
                    "type": "string"
                  },
                  "selectedDay": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated booking"
          },
          "400": {
            "description": "Nothing to update"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not your booking"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a booking",
        "tags": [
          "Bookings"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not your booking"
          },
          "404": {
            "description": "Booking not found"
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Get users",
        "description": "An admin receives every user. Any other signed in user receives a list holding only their own record. The password hash is never included.\n",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "A list of users"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "summary": "Get one user",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The user"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        }
      },
      "put": {
        "summary": "Update a user",
        "description": "Only the display name and the email can be changed. The role is never read from the body, so a customer cannot promote themselves.\n",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated user"
          },
          "400": {
            "description": "Nothing to update"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          },
          "409": {
            "description": "That email is already in use"
          }
        }
      },
      "delete": {
        "summary": "Delete a user",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Not your account"
          },
          "404": {
            "description": "User not found"
          }
        }
      }
    }
  },
  "tags": []
}