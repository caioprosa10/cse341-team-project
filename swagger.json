{
  "openapi": "3.0.0",
  "info": {
    "title": "Kizuna Rail API",
    "version": "1.0.0",
    "description": "JSON endpoints that power the Kizuna Rail pages: trips, schedules, bookings, ticket classes, stations and trains."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current server"
    }
  ],
  "components": {},
  "paths": {
    "/api/trips": {
      "get": {
        "summary": "Get all trips",
        "tags": [
          "Trips"
        ],
        "responses": {
          "200": {
            "description": "A list of trips"
          },
          "500": {
            "description": "Failed to fetch trips"
          }
        }
      }
    },
    "/api/trips/{id}": {
      "get": {
        "summary": "Get one trip by id",
        "tags": [
          "Trips"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom trip id, such as alpine-panorama",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching trip"
          },
          "404": {
            "description": "Trip not found"
          },
          "500": {
            "description": "Failed to fetch trip"
          }
        }
      }
    },
    "/api/trips/{id}/schedules": {
      "get": {
        "summary": "Get the schedules for a trip",
        "description": "Returns every schedule for the trip. When the optional month is given, the schedules are returned only if the trip operates in that month, because schedules store weekdays while the operating months live on the trip itself. A trip that does not run that month returns an empty list.\n",
        "tags": [
          "Schedules"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom trip id, such as alpine-panorama",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "month",
            "required": false,
            "description": "Month number from 1 (January) to 12 (December)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The schedules for the trip"
          },
          "400": {
            "description": "The month is not a whole number from 1 to 12"
          },
          "500": {
            "description": "Failed to fetch schedules"
          }
        }
      }
    },
    "/api/bookings": {
      "get": {
        "summary": "Get all bookings",
        "tags": [
          "Bookings"
        ],
        "responses": {
          "200": {
            "description": "A list of bookings, newest first"
          },
          "500": {
            "description": "Failed to fetch bookings"
          }
        }
      }
    },
    "/api/trains": {
      "get": {
        "summary": "Get all trains",
        "tags": [
          "Trains"
        ],
        "description": "Answers with the trains wrapped in an object, as { \"trains\": [ ... ] }. This endpoint predates the newer ones, which return bare arrays, and the trains page reads payload.trains.\n",
        "responses": {
          "200": {
            "description": "An object with a trains array"
          },
          "500": {
            "description": "Failed to fetch trains"
          }
        }
      }
    },
    "/api/trains/{id}": {
      "get": {
        "summary": "Get one train by id",
        "tags": [
          "Trains"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "description": "The custom train id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The matching train"
          },
          "404": {
            "description": "Train not found"
          },
          "500": {
            "description": "Failed to fetch train"
          }
        }
      }
    }
  },
  "tags": []
}