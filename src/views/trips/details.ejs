<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= details.name %></h1>
            <p class="route-description"><%= details.description %></p>
            
            <% if (details.highlights && details.highlights.length > 0) { %>
            <div class="highlights">
                <% details.highlights.forEach(function(highlight) { %>
                <span class="highlight-tag"><%= highlight %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <% if (details.imageUrl) { %>
        <div class="route-image">
            <img src="<%= details.imageUrl %>" alt="<%= details.name %>">
        </div>
        <% } %>
    </div>

    <div class="route-info">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Region</span>
                <span class="info-value region-<%= details.region %>"><%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value"><%= details.duration %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value"><%= details.distance %> km</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Best Season</span>
                <span class="info-value season-<%= details.bestSeason %>"><%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %></span>
            </div>
        </div>

        <div class="route-stations">
            <h2>Trip</h2>
            <div class="stations">
                <div class="station">
                    <span class="station-label">Start</span>
                    <span class="station-name"><%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %></span>
                    <button type="button" class="station-info-btn" data-station-id="<%= details.startStation %>" aria-expanded="false">
                        Station info
                    </button>
                    <div class="station-details" id="station-details-<%= details.startStation %>" hidden></div>
                </div>
                <div class="station">
                    <span class="station-label">End</span>
                    <span class="station-name"><%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %></span>
                    <button type="button" class="station-info-btn" data-station-id="<%= details.endStation %>" aria-expanded="false">
                        Station info
                    </button>
                    <div class="station-details" id="station-details-<%= details.endStation %>" hidden></div>
                </div>
            </div>
        </div>

        <div class="route-operating">
            <h2>Operating Schedule</h2>
            <div class="months-grid">
                <% details.operatingMonths.forEach(function(month) { %>
                <span class="month-badge"><%= month %></span>
                <% }); %>
            </div>
        </div>

        <div class="route-schedules" id="schedules-section" data-trip-id="<%= details.id %>">
            <h2>Available Schedules</h2>

            <div class="schedule-filter">
                <label for="month-filter">Show schedules for:</label>
                <select id="month-filter">
                    <option value="">All operating months</option>
                    <% details.operatingMonths.forEach(function(month) { %>
                        <option value="<%= month %>"><%= monthNames[month - 1] %></option>
                    <% }); %>
                </select>
            </div>

            <div class="schedules-state" id="schedules-loading">Loading schedules...</div>
            <div class="schedules-state schedules-error" id="schedules-error" hidden></div>
            <div class="schedules-state" id="schedules-empty" hidden>
                This trip does not run in the selected month.
            </div>

            <div class="schedules-grid" id="schedules-list"></div>

            <template id="schedule-card-template">
                <div class="schedule-card">
                    <div class="schedule-times">
                        <div class="time-block">
                            <span class="time-label">Departs</span>
                            <span class="time-value" data-field="departure"></span>
                        </div>
                        <span class="time-arrow">&#8594;</span>
                        <div class="time-block">
                            <span class="time-label">Arrives</span>
                            <span class="time-value" data-field="arrival"></span>
                        </div>
                    </div>
                    <div class="schedule-days" data-field="days"></div>
                    <a class="book-btn" data-field="book-link">Book Now</a>
                </div>
            </template>
        </div>
    </div>
</article>

<%- include('../partials/footer') %>