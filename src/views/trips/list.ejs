<%- include('../partials/header') %>
<h1><%- title %></h1>

<form id="filters" class="trip-filters" role="search">
    <label>
        Search by Region:
        <select id="region-filter" name="region">
            <option value="all">All Regions</option>
        </select>
    </label>

    <label>
        Search by Season:
        <select id="season-filter" name="season">
            <option value="all">Any Season</option>
        </select>
    </label>

    <label>
        Keyword:
        <input type="search" id="trip-search" name="q" maxlength="100"
            placeholder="Trip name or description">
    </label>

    <button type="submit" class="pagination-btn">Search</button>
    <button type="button" class="trip-filters-clear" id="trip-filters-clear">Clear</button>
</form>

<div class="trips-state" id="trips-loading">Loading trips...</div>
<div class="trips-state trips-error" id="trips-error" hidden></div>
<div class="trips-state" id="trips-empty" hidden>No trips match the selected filters.</div>

<p class="trips-summary" id="trips-summary" aria-live="polite"></p>

<div class="routes-grid" id="trips-list"></div>

<nav class="pagination" id="trips-pagination" aria-label="Trip list pages" hidden>
    <button type="button" class="pagination-btn" id="trips-prev">&larr; Previous</button>
    <span class="pagination-status" id="trips-page-status"></span>
    <button type="button" class="pagination-btn" id="trips-next">Next &rarr;</button>
</nav>

<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>

        <div class="station-info">
            <div class="station">
                <div class="station-type">From:</div>
                <div class="station-name" data-field="start-station"></div>
            </div>
            <div class="route-arrow">&#8594;</div>
            <div class="station">
                <div class="station-type">To:</div>
                <div class="station-name" data-field="end-station"></div>
            </div>
        </div>

        <div class="route-details">
            <div class="detail-item">
                <span class="detail-icon">&#128337;</span>
                <span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span>
            </div>
            <div class="detail-item">
                <span class="detail-icon">&#128205;</span>
                <span><span class="detail-label">Distance:</span> <span data-field="distance"></span></span>
            </div>
            <div class="detail-item">
                <span class="season-badge" data-field="season"></span>
            </div>
        </div>

        <div class="route-description" data-field="description"></div>

        <div class="highlights">
            <div class="highlights-list" data-field="highlights"></div>
        </div>

        <div class="route-actions">
            <a class="view-details-btn" data-field="details-link">
                View Details &amp; Book &#8594;
            </a>
        </div>
    </div>
</template>

<%- include('../partials/footer') %>
