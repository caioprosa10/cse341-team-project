<%- include('partials/header') %>
<div class="dashboard">
    <h1>Welcome, <%= user.name %></h1>
    <p class="dashboard-intro">
        Signed in as <%= user.email %>. Below are the bookings that carry your
        email address.
    </p>

    <ul class="dashboard-links">
        <li><a href="/bookings-admin">Booking admin</a></li>
        <li><a href="/admin/users">User admin</a></li>
    </ul>

    <h2>Your bookings</h2>
    <div class="bookings-state" id="bookings-loading">Loading your bookings...</div>
    <div class="bookings-state bookings-error" id="bookings-error" hidden></div>
    <div class="bookings-state" id="bookings-empty" hidden>
        You have no bookings yet. <a href="/trips">Browse the trips</a> to make one.
    </div>

    <div class="bookings-list" id="bookings-list"></div>

    <%# Mesma marcacao da pagina de bookings admin, para reaproveitar o CSS
        de hydration.css em vez de duplicar regras para o mesmo cartao. %>
    <template id="booking-card-template">
        <article class="booking-card">
            <header class="booking-card-header">
                <h2 data-field="reference"></h2>
                <span class="booking-date" data-field="created"></span>
            </header>

            <dl class="booking-specs">
                <div class="spec-item">
                    <dt>Trip</dt>
                    <dd data-field="trip"></dd>
                </div>
                <div class="spec-item">
                    <dt>Schedule</dt>
                    <dd data-field="schedule"></dd>
                </div>
                <div class="spec-item">
                    <dt>Ticket Class</dt>
                    <dd data-field="ticket-class"></dd>
                </div>
                <div class="spec-item">
                    <dt>Travel Day</dt>
                    <dd data-field="day"></dd>
                </div>
                <div class="spec-item">
                    <dt>Passengers</dt>
                    <dd data-field="passenger-count"></dd>
                </div>
            </dl>

            <ul class="booking-passengers" data-field="passengers"></ul>
        </article>
    </template>
</div>
<%- include('partials/footer') %>
