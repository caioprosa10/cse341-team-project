<%- include('partials/header') %>
<div class="dashboard">
    <h1>Welcome, <%= user.name %></h1>
    <p class="dashboard-intro">
        Signed in as <%= user.email %>. Below are the bookings that carry your
        email address.
    </p>

    <ul class="dashboard-links">
        <li><a href="/bookings-admin">Booking admin</a></li>
        <li><a href="/admin/users">User admin</a></li>
    </ul>

    <h2>Your bookings</h2>
    <div class="bookings-state" id="bookings-loading">Loading your bookings...</div>
    <div class="bookings-state bookings-error" id="bookings-error" hidden></div>
    <div class="bookings-state" id="bookings-empty" hidden>
        You have no bookings yet. <a href="/trips">Browse the trips</a> to make one.
    </div>

    <div class="bookings-grid" id="bookings-list"></div>

    <template id="booking-card-template">
        <div class="booking-card">
            <div class="booking-header">
                <span class="booking-reference" data-field="reference"></span>
                <span class="booking-created" data-field="created"></span>
            </div>
            <dl class="booking-details">
                <div><dt>Trip</dt><dd data-field="trip"></dd></div>
                <div><dt>Schedule</dt><dd data-field="schedule"></dd></div>
                <div><dt>Ticket class</dt><dd data-field="ticket-class"></dd></div>
                <div><dt>Travel day</dt><dd data-field="day"></dd></div>
                <div><dt>Passengers</dt><dd data-field="passenger-count"></dd></div>
            </dl>
            <ul class="booking-passengers" data-field="passengers"></ul>
        </div>
    </template>
</div>
<%- include('partials/footer') %>
